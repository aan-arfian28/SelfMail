# --- required ---
DATABASE_URL=postgres://selfmail:selfmail@localhost:5432/selfmail?sslmode=disable
STALWART_URL=http://localhost:8081   # admin API (JMAP)
STALWART_USER=admin@example.com   # from scripts/bootstrap-stalwart.sh
STALWART_PASSWORD=change-me
MAIL_HOST=mail.example.com        # public hostname of the Stalwart server (MX target)

# --- DNS provisioning (optional; without a token, create records manually) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=               # optional; looked up per domain when empty
SERVER_IP=                        # public IPv4, used in SPF (ip4:)
SPF_INCLUDE=                      # optional extra SPF include
DKIM_SELECTOR=default
DMARC_POLICY=quarantine

# --- tunables (defaults shown) ---
LISTEN_ADDR=:8080
SPAM_JUNK_THRESHOLD=5.0
SPAM_REJECT_THRESHOLD=15.0
MAX_MESSAGE_SIZE=26214400
SUBMISSION_RATE_LIMIT_PER_HOUR=200
INBOUND_RATE_LIMIT_PER_MIN_PER_IP=100
FEEDBACK_RATE_LIMIT_PER_MIN=100
OUTBOUND_MAX_AGE=120h
DNS_TIMEOUT=5s
DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
DNS_STATUS_TTL=5m
USAGE_CACHE_TTL=60s
ALIAS_MAX_TARGETS=5
PASSWORD_LENGTH=16
API_RATE_LIMIT_PER_HOUR=1000
RUN_WORKER=true
